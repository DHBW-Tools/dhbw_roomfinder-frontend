# Example environment variables for DHBW Roomfinder
# Copy this file to '.env.local' for local development or use as the basis for Docker / Kubernetes env files.

# Public API base used by the frontend to fetch room data (must include protocol)
# For local dev against the provided mock server set to: http://localhost:8080
NEXT_PUBLIC_API_BASE=http://localhost:8080

# The port the Next.js app should listen on when run directly (not required for Vercel)
PORT=3000

# Node environment
NODE_ENV=development

# Optional: set a base URL used by server-side code (if any)
#NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: admin/API key for protected endpoints (do NOT commit real keys)
#ADMIN_API_KEY=replace_me

# Docker usage example:
#  docker run --env-file .env -p ${PORT}:${PORT} your-image
